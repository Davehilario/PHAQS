# Copy this file to `.env` and fill values (do NOT commit `.env` with real secrets)
# Database
DB_HOST=localhost
DB_NAME=health_center_system
DB_USER=root
DB_PASS=

# Google
GOOGLE_CLIENT_ID=

# SMTP - configure to enable password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=you@example.com
SMTP_PASSWORD=

# Optional flags
ALLOW_LOCAL_GOOGLE_DEMO=0
